+# Copyright 2020-2025 ETH Zurich and the SeBS authors. All rights reserved.
+import os
+
+# Upstream delay (ms) and dataset size (bytes) per input size. The dataset is fetched and
+# parsed once per instance, so these set the startup cost on top of importing pandas.
+size_generators = {
+    'test': (10, 65536),
+    'small': (200, 1048576),
+    'large': (1000, 8388608),
+}
+
+
+def upstream_url():
+    url = os.environ.get('SEBS_MOCK_UPSTREAM')
+    if not url:
+        raise RuntimeError(
+            'Set SEBS_MOCK_UPSTREAM to the URL of the mock upstream service '
+            '(python -m mcp_bench.mock_upstream), reachable from the functions.'
+        )
+    return url
+
+
+def buckets_count():
+    return (0, 0)
+
+
+def generate_input(data_dir, size, benchmarks_bucket, input_paths, output_paths, upload_func, nosql_func):
+    latency_ms, dataset_size = size_generators[size]
+    return {
+        'upstream': upstream_url(),
+        'latency_ms': latency_ms,
+        'size': dataset_size,
+        'seed': 1,
+        'group_by': 'month',
+        'min_rating': 3.0,
+        'limit': 12,
+    }
+
+
+def validate_output(data_dir: str | None, input_config: dict, output: dict, language: str, storage = None) -> str | None:
+    result = output.get('result', {})
+    groups = result.get('groups')
+    limit = input_config.get('limit', 12)
+    if not isinstance(groups, list) or not 0 < len(groups) <= limit:
+        return f"Expected between 1 and {limit} groups, got {groups!r:.200}"
+    if not 0 < result.get('matching', 0) <= result.get('rows', 0):
+        return f"Matching rows {result.get('matching')} not within the dataset's {result.get('rows')} rows"
+    if any(g.get('mean_rating', 0) < input_config.get('min_rating', 0) for g in groups):
+        return "A group's mean rating is below min_rating"
+    measurement = output.get('measurement', {})
+    if measurement.get('loaded') and measurement.get('upstream_wait_us', 0) < input_config['latency_ms'] * 1000:
+        return f"Upstream wait {measurement.get('upstream_wait_us')} us is shorter than the configured latency"
+    return None
