+++ b/benchmarks/wrappers/mcp/python/mcp_sdk_bridge.py
@@ -0,0 +1,188 @@
+# Copyright 2020-2025 ETH Zurich and the SeBS authors. All rights reserved.
+"""Serve a benchmark built on the official MCP Python SDK from a SeBS function.
+
+The `sdk` language variant of an MCP benchmark adds `mcp_server.py`, an ordinary SDK
+server (`mcp = MCPServer(...)` with `@mcp.tool()` functions), and the SDK in its
+requirements. This module runs that server the way it runs in production on a function
+platform: the SDK's own Streamable HTTP app (stateless, JSON responses) behind an
+in-process ASGI adapter, as Mangum on Lambda or AsgiMiddleware on Azure do. The
+platform wrapper hands over the raw HTTP body and headers, so both protocol eras work:
+the handshake era (`initialize` first) and 2026-07-28 (self-contained requests).
+
+Unlike the stdlib shim, the server module (and with it the SDK) is imported when
+the wrapper loads, i.e. at instance startup, as real MCP servers do. That time is
+reported as `init_import_us`; `init_us` adds building the app and starting it.
+
+SeBS measurements reach the client in `_meta.sebs` of every result, added by an SDK
+server middleware, so the benchmark code itself stays free of SeBS specifics. For
+`tools/call` the middleware times the call through the SDK (argument validation, the
+tool in its worker thread, result conversion): `begin`/`end`, `cpu_us`, `child_cpu_us`.
+
+Only the standard library is imported at module level here; the SDK comes with the
+benchmark's `mcp_server`.
+"""
+
+import asyncio
+import datetime
+import importlib
+import json
+import os
+import resource
+import threading
+import time
+
+SERVER_MODULE = "mcp_server"
+
+
+def is_sdk_package(code_dir: str) -> bool:
+    """True if the deployed code is an SDK variant (it ships the benchmark's SDK server)."""
+    return os.path.exists(os.path.join(code_dir, SERVER_MODULE + ".py"))
+
+
+def is_jsonrpc(body: bytes) -> bool:
+    """A JSON-RPC message or batch, as opposed to a plain SeBS invocation."""
+    try:
+        message = json.loads(body)
+    except ValueError:
+        return False
+    messages = message if isinstance(message, list) else [message]
+    return bool(messages) and all(isinstance(m, dict) and m.get("jsonrpc") == "2.0" for m in messages)
+
+
+def _children_cpu():
+    usage = resource.getrusage(resource.RUSAGE_CHILDREN)
+    return usage.ru_utime + usage.ru_stime
+
+
+class _SebsMeta:
+    """SDK server middleware: adds the wrapper's measurements to every result's `_meta.sebs`."""
+
+    def __init__(self, bridge):
+        self.bridge = bridge
+
+    async def __call__(self, ctx, call_next):
+        meta = dict(self.bridge.request_meta)
+        if ctx.method == "tools/call":
+            begin = datetime.datetime.now()
+            cpu_begin, child_begin = time.process_time(), _children_cpu()
+            result = await call_next(ctx)
+            end = datetime.datetime.now()
+            meta.update(
+                begin=begin.strftime("%s.%f"),
+                end=end.strftime("%s.%f"),
+                cpu_us=int((time.process_time() - cpu_begin) * 1e6),
+                child_cpu_us=int((_children_cpu() - child_begin) * 1e6),
+                import_us=0,  # the server was imported at startup, see init_import_us
+            )
+        else:
+            result = await call_next(ctx)
+        if ctx.request_id is None:  # notification: no result to annotate
+            return result
+        if isinstance(result, dict):
+            result.setdefault("_meta", {})["sebs"] = meta
+        elif result is not None and hasattr(result, "meta"):
+            result.meta = {**(result.meta or {}), "sebs": meta}
+        return result
+
+
+class SDKBridge:
+    """One per instance: imports the benchmark's SDK server, starts its HTTP app, serves requests."""
+
+    is_jsonrpc = staticmethod(is_jsonrpc)
+
+    def __init__(self, package: str):
+        begin = time.perf_counter()
+        module = importlib.import_module(f"{package}.{SERVER_MODULE}")
+        self.init_import_us = int((time.perf_counter() - begin) * 1e6)
+
+        self.server = module.mcp
+        self.server.middleware.append(_SebsMeta(self))
+        # host="0.0.0.0": no DNS-rebinding allowlist. The SDK enables one for 127.0.0.1/localhost
+        # only; behind a platform endpoint the Host header is the function's public name.
+        self.app = self.server.streamable_http_app(stateless_http=True, json_response=True, host="0.0.0.0")
+        self.loop = asyncio.new_event_loop()
+        self.lock = threading.Lock()  # one request at a time, like a function instance
+        self.request_meta = {}
+        self._lifespan_events = asyncio.Queue()
+        self.loop.run_until_complete(self._start())
+        self.init_us = int((time.perf_counter() - begin) * 1e6)
+        self.versions = self._loaded_versions()
+
+    @staticmethod
+    def _loaded_versions():
+        """Versions of the SDK stack actually imported. A platform runtime may ship some of these
+        packages itself (GCP's functions-framework brings starlette and anyio) ahead of ours."""
+        import importlib.metadata
+        import sys
+        versions = {}
+        for module, distribution in (("mcp", "mcp"), ("starlette", "starlette"), ("anyio", "anyio"),
+                                     ("pydantic", "pydantic")):
+            loaded = sys.modules.get(module)
+            path = os.path.dirname(getattr(loaded, "__file__", "") or "")
+            try:
+                dist = next((d for d in importlib.metadata.distributions(path=[os.path.dirname(path)])
+                             if d.metadata["Name"].lower() == distribution), None)
+                versions[module] = dist.version if dist else importlib.metadata.version(distribution)
+            except Exception:  # never fail a request over a diagnostic
+                versions[module] = None
+        return versions
+
+    async def _start(self):
+        started = self.loop.create_future()
+
+        async def receive():
+            return await self._lifespan_events.get()
+
+        async def send(message):
+            if message["type"] == "lifespan.startup.complete":
+                started.set_result(None)
+            elif message["type"] == "lifespan.startup.failed":
+                started.set_exception(RuntimeError(message.get("message", "lifespan startup failed")))
+
+        # The lifespan task stays pending for the life of the instance: it holds the SDK's session manager.
+        self._lifespan = self.loop.create_task(self.app({"type": "lifespan", "asgi": {"version": "3.0"}}, receive, send))
+        await self._lifespan_events.put({"type": "lifespan.startup"})
+        await started
+
+    def handle(self, body: bytes, headers: dict, meta: dict):
+        """Serve one HTTP request (POST to the MCP endpoint). Returns (status, headers, body)."""
+        with self.lock:
+            self.request_meta = dict(meta, init_import_us=self.init_import_us, init_us=self.init_us)
+            if meta.get("is_cold"):  # once per instance, to keep warm responses unchanged
+                self.request_meta["sdk_versions"] = self.versions
+            return self.loop.run_until_complete(self._request(body, headers))
+
+    async def _request(self, body: bytes, headers: dict):
+        scope = {
+            "type": "http", "asgi": {"version": "3.0"}, "http_version": "1.1", "method": "POST",
+            "scheme": "https", "path": "/mcp", "raw_path": b"/mcp", "query_string": b"", "root_path": "",
+            "headers": [(str(k).lower().encode("latin-1"), str(v).encode("latin-1")) for k, v in headers.items()],
+            "client": ("0.0.0.0", 0), "server": ("function", 443),
+        }
+        done = asyncio.Event()
+        body_sent = False
+        response = {"status": 500, "headers": {}, "body": b""}
+
+        async def receive():
+            nonlocal body_sent
+            if not body_sent:
+                body_sent = True
+                return {"type": "http.request", "body": body, "more_body": False}
+            await done.wait()
+            return {"type": "http.disconnect"}
+
+        async def send(message):
+            if message["type"] == "http.response.start":
+                response["status"] = message["status"]
+                response["headers"] = {k.decode("latin-1"): v.decode("latin-1") for k, v in message.get("headers", [])}
+            elif message["type"] == "http.response.body":
+                response["body"] += message.get("body", b"")
+                if not message.get("more_body", False):
+                    done.set()
+
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            done.set()
+        response["headers"].pop("content-length", None)  # platforms set their own
+        return response["status"], response["headers"], response["body"]
