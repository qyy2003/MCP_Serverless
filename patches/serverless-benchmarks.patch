+@route('/mcp', method='POST')
+def process_mcp_request():
+    global cold_start
+    is_cold, cold_start = cold_start, False
+    meta = {'request_id': str(uuid.uuid4()), 'is_cold': is_cold}
+    if sdk_bridge is not None:
+        # SDK variant: the raw HTTP request goes to the SDK's Streamable HTTP app.
+        status, headers, body = sdk_bridge.handle(request.body.read(), dict(request.headers), meta)
+        response.status = status
+        for key, value in headers.items():
+            response.set_header(key, value)
+        return body
+    from function import mcp_shim
+
+    def call_tool(arguments):
+        begin = datetime.datetime.now()
+        cpu = CPUTimer()
+        # The benchmark is imported on first use, so a fresh container's first call pays for it.
+        import_begin = time.perf_counter()
+        from function import function
+        import_us = int((time.perf_counter() - import_begin) * 1e6)
+        ret = function.handler(arguments)
+        end = datetime.datetime.now()
+        return ret, dict(meta, begin=begin.strftime('%s.%f'), end=end.strftime('%s.%f'),
