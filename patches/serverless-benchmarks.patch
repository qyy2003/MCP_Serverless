+    measurement = output.get('measurement', {})
+    if measurement.get('upstream_wait_us', 0) < input_config['latency_ms'] * 1000:
+        return f"Upstream wait {measurement.get('upstream_wait_us')} us is shorter than the configured latency"
+    return None
