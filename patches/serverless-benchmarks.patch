index 00000000..8ee7e7fe
--- /dev/null
+++ b/benchmarks/600.mcp/630.data-analysis/python/function.py
@@ -0,0 +1,115 @@
+# Copyright 2020-2025 ETH Zurich and the SeBS authors. All rights reserved.
+"""Heavy-startup MCP tool: summarise a dataset with pandas.
+
+The third tool class next to the API wrapper (610) and the page fetcher (620): servers
+that are expensive to start. Real MCP servers of this kind (finance, data analysis,
+knowledge bases) import a scientific stack and load reference data once per process,
+then answer each call from memory (docs/real-servers.md: 0.5-6 s to start at 1 vCPU,
+some fetching their data at startup). The cost that matters is paid once per instance,
+so it is part of every cold start:
+
+- importing pandas and numpy (module level, measured by the wrapper's import time),
+- fetching the dataset from the upstream and building the DataFrame (on the first call
+  of an instance, cached for later calls; `load_us` in the measurement, 0 when warm).
+
+Each call then filters and aggregates the cached frame, which is cheap. The upstream is
+the mock service of the MCP benchmark harness (`/api`: JSON records, `size` bytes after
+`latency_ms`).
+"""
+
+import http.client
+import json
+from time import perf_counter
+from urllib.parse import urlencode, urlsplit
+
+import numpy as np
+import pandas as pd
+
+USER_AGENT = "SeBS-MCP/0.1 (https://github.com/spcl/serverless-benchmarks)"
+GROUPS = ("month", "tag", "stock")
+
+# Loaded once per instance: (upstream, size, seed) -> DataFrame.
+_datasets = {}
+
+
+def _us(seconds):
+    return int(seconds * 1e6)
+
+
+def _fetch(upstream, latency_ms, size, seed, timeout=120):
+    query = urlencode({"latency_ms": latency_ms, "size": size, "seed": seed})
+    parts = urlsplit("{}/api?{}".format(upstream.rstrip("/"), query))
+    cls = http.client.HTTPSConnection if parts.scheme == "https" else http.client.HTTPConnection
+    conn = cls(parts.netloc, timeout=timeout)
+    try:
+        conn.request("GET", parts.path + "?" + parts.query, headers={"User-Agent": USER_AGENT})
+        response = conn.getresponse()
+        body = response.read()
+    finally:
+        conn.close()
+    if response.status != 200:
+        raise RuntimeError("Upstream returned HTTP {}: {}".format(response.status, body[:200]))
+    return body
+
+
+def load(upstream, latency_ms, size, seed):
+    """The dataset as a DataFrame, fetched and prepared on an instance's first call."""
+    key = (upstream, size, seed)
+    if key in _datasets:
+        return _datasets[key], {"loaded": False, "load_us": 0}
+    begin = perf_counter()
+    body = _fetch(upstream, latency_ms, size, seed)
+    fetched = perf_counter()
+    frame = pd.DataFrame(json.loads(body)["items"])
+    frame["updated"] = pd.to_datetime(frame["updated"], utc=True)
+    frame["month"] = frame["updated"].dt.strftime("%Y-%m")
+    frame["stock"] = np.where(frame["in_stock"], "in stock", "sold out")
+    frame["value"] = frame["price"] * frame["rating"]
+    tags = frame[["id", "tags"]].explode("tags").rename(columns={"tags": "tag"})
+    frame = frame.drop(columns=["tags", "description"])
+    _datasets[key] = (frame, tags)
+    end = perf_counter()
+    return _datasets[key], {
+        "loaded": True,
+        "load_us": _us(end - begin),
+        "upstream_wait_us": _us(fetched - begin),
+        "parse_us": _us(end - fetched),
+        "upstream_bytes": len(body),
+        "rows": len(frame),
+    }
+
+
+def handler(event):
+    (frame, tags), measurement = load(
+        event["upstream"], event.get("latency_ms", 0), event.get("size", 1 << 20), event.get("seed", 0)
+    )
+    group_by = event.get("group_by", "month")
+    if group_by not in GROUPS:
+        raise ValueError("group_by must be one of {}".format(", ".join(GROUPS)))
+
+    begin = perf_counter()
+    rows = frame[frame["rating"] >= event.get("min_rating", 0)]
+    if group_by == "tag":
+        rows = rows.merge(tags, on="id")
+    stats = (
+        rows.groupby(group_by)
+        .agg(count=("id", "size"), mean_price=("price", "mean"), median_price=("price", "median"),
+             p90_price=("price", lambda s: s.quantile(0.9)), mean_rating=("rating", "mean"),
+             value=("value", "sum"))
+        .sort_values("value", ascending=False)
+    )
+    limit = event.get("limit", 12)
+    result = {
+        "rows": int(len(frame)),
+        "matching": int(rows["id"].nunique()),
+        "group_by": group_by,
+        "groups": [
+            {group_by: str(name), "count": int(r["count"]), "mean_price": round(float(r["mean_price"]), 2),
+             "median_price": round(float(r["median_price"]), 2), "p90_price": round(float(r["p90_price"]), 2),
+             "mean_rating": round(float(r["mean_rating"]), 2)}
+            for name, r in stats.head(limit).iterrows()
+        ],
+        "total_groups": int(len(stats)),
+    }
+    measurement["process_us"] = _us(perf_counter() - begin)
+    return {"result": result, "measurement": measurement}
