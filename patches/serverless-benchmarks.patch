+class CPUTimer:
+    """CPU time of a call: this process (cpu_us) and its finished child processes (child_cpu_us).
+
+    process_time() misses work done in subprocesses, e.g. ffmpeg in 220.video-processing.
+    """
+
+    def __init__(self):
+        self.cpu = time.process_time()
+        self.children = self._children()
+
+    @staticmethod
+    def _children():
+        usage = resource.getrusage(resource.RUSAGE_CHILDREN)
+        return usage.ru_utime + usage.ru_stime
+
+    def stop(self):
+        return {
+            'cpu_us': int((time.process_time() - self.cpu) * 1e6),
+            'child_cpu_us': int((self._children() - self.children) * 1e6),
+        }
 # Each container runs one server process, so its first request is a cold start
 cold_start = True
 
