+# Copyright 2020-2025 ETH Zurich and the SeBS authors. All rights reserved.
+"""The fetch tool as an MCP server built on the official Python SDK.
+
+Same tool logic as the default variant (function.py), registered the way real MCP
+servers do: an `MCPServer` instance at module level and a decorated, typed tool
+function, whose signature becomes the input schema. The SeBS wrapper finds `mcp`
+here and serves it through the SDK's Streamable HTTP app.
+"""
+
+from typing import Annotated, Any
+
+from mcp.server.mcpserver import MCPServer
+from pydantic import Field
+
+from . import function
+
+mcp = MCPServer("sebs-fetch")
+
+
+@mcp.tool()
+def fetch(
+    upstream: Annotated[str, Field(description="Benchmark parameter: base URL of the page server.")],
+    latency_ms: Annotated[float, Field(description="Benchmark parameter: server response delay in milliseconds.")] = 0,
+    size: Annotated[int, Field(description="Benchmark parameter: page size in bytes.")] = 100000,
+    seed: Annotated[int, Field(description="Benchmark parameter: selects the generated page.")] = 0,
+    max_length: Annotated[int, Field(description="Maximum number of characters to return.")] = 5000,
+    start_index: Annotated[
+        int, Field(description="Return content starting at this character, for paging through long pages.")
+    ] = 0,
+    reuse_connection: Annotated[
+        bool, Field(description="Benchmark parameter: keep the connection alive across calls.")
+    ] = True,
+) -> dict[str, Any]:
+    """Fetch a web page and return its main content as markdown."""
+    return function.handler(dict(
+        upstream=upstream, latency_ms=latency_ms, size=size, seed=seed, max_length=max_length,
+        start_index=start_index, reuse_connection=reuse_connection,
