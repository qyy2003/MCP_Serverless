new file mode 100644
index 00000000..e2b4efbe
--- /dev/null
+++ b/benchmarks/wrappers/mcp/python/mcp_shim.py
@@ -0,0 +1,182 @@
+# Copyright 2020-2025 ETH Zurich and the SeBS authors. All rights reserved.
+"""Minimal MCP server shim that exposes a SeBS benchmark as a single MCP tool.
+
+Implements the stateless subset of the MCP Streamable HTTP transport: each
+POST carries one JSON-RPC message, and the server answers with a single
+application/json response (no SSE, no Mcp-Session-Id). This is the mode
+serverless MCP hosts (Lambda, Workers, Vercel) run in.
+
+Both protocol eras are served. Handshake revisions (up to 2025-11-25) start a session
+with `initialize`. In 2026-07-28 every request is self-contained: it names its protocol
+version (and the client) in `params._meta`, `initialize` and `ping` are gone, a client
+may probe `server/discover` instead, and results carry `resultType` (and the cacheable
+ones `cacheScope`/`ttlMs`). Responses to handshake-era requests are unchanged. The
+`Mcp-Method`/`Mcp-Name` headers that 2026-07-28 clients send are not checked, since the
+wrappers pass only the body.
+
+The shim deliberately uses only the standard library, so wrapping a
+benchmark as an MCP tool does not change its package size or import time;
+the measured difference to a plain invocation is the protocol itself.
+
+Platform wrappers call `handle(message, call_tool, meta)`, where `call_tool(arguments)`
+runs the benchmark and returns `(result, meta)`; `meta` carries the usual SeBS
+measurements (begin, end, is_cold, container_id, request_id) and is returned
+to the client in the tool result's `_meta.sebs`. The `meta` passed to handle
+(is_cold, container_id, ...) goes into `_meta.sebs` of the other results, so a
+cold start absorbed by `initialize` or `tools/list` is visible too.
+"""
+
+import json
+import os
+
+PROTOCOL_VERSIONS = ["2025-11-25", "2025-06-18", "2025-03-26"]  # handshake era
+MODERN_PROTOCOL_VERSIONS = ["2026-07-28"]  # no handshake
+SERVER_INFO = {"name": "sebs-mcp", "version": "0.1.0"}
+
+PARSE_ERROR = -32700
+INVALID_REQUEST = -32600
+METHOD_NOT_FOUND = -32601
+INVALID_PARAMS = -32602
+UNSUPPORTED_PROTOCOL_VERSION = -32022
+
+PROTOCOL_VERSION_META = "io.modelcontextprotocol/protocolVersion"
+SERVER_INFO_META = "io.modelcontextprotocol/serverInfo"
+# Like the SDK's default: tools/list and discover results may not be cached across requests.
+CACHE = {"cacheScope": "private", "ttlMs": 0}
+
+_tool = None
+
+
+def tool_definition() -> dict:
+    """The tool advertised in tools/list, read once from mcp.json next to the function code."""
+    global _tool
+    if _tool is None:
+        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "mcp.json")
+        if os.path.exists(path):
+            with open(path, "r") as f:
+                _tool = json.load(f)
+        else:
+            _tool = {
+                "name": "benchmark",
+                "description": "SeBS benchmark function.",
+                "inputSchema": {"type": "object"},
+            }
+    return _tool
+
+
+def is_mcp_message(body) -> bool:
+    return isinstance(body, dict) and body.get("jsonrpc") == "2.0" and "method" in body
+
+
+def _result(msg_id, result: dict) -> dict:
+    return {"jsonrpc": "2.0", "id": msg_id, "result": result}
+
+
+def _error(msg_id, code: int, message: str) -> dict:
+    return {"jsonrpc": "2.0", "id": msg_id, "error": {"code": code, "message": message}}
+
+
+def handle(message, call_tool, meta=None):
+    """Process one JSON-RPC message.
+
+    Returns the response message, or None for notifications and responses
+    (the transport then answers with HTTP 202 and no body).
+    """
+    if not is_mcp_message(message):
+        return _error(None, INVALID_REQUEST, "Expected a single JSON-RPC 2.0 request")
+
+    method = message["method"]
+    msg_id = message.get("id")
+    params = message.get("params") or {}
+
+    # Notifications have no id and get no response.
+    if msg_id is None:
+        return None
+
+    sebs_meta = {"_meta": {"sebs": meta}} if meta else {}
+
+    request_meta = params.get("_meta") if isinstance(params.get("_meta"), dict) else {}
+    if PROTOCOL_VERSION_META in request_meta:
+        return _handle_modern(msg_id, method, params, request_meta[PROTOCOL_VERSION_META], call_tool, meta)
+
+    if method == "initialize":
+        requested = params.get("protocolVersion")
+        version = requested if requested in PROTOCOL_VERSIONS else PROTOCOL_VERSIONS[0]
+        return _result(
+            msg_id,
+            {
+                "protocolVersion": version,
+                "capabilities": {"tools": {"listChanged": False}},
+                "serverInfo": SERVER_INFO,
+                **sebs_meta,
+            },
+        )
+
+    if method == "ping":
+        return _result(msg_id, {**sebs_meta})
+
+    if method == "tools/list":
+        return _result(msg_id, {"tools": [tool_definition()], **sebs_meta})
+
+    if method == "tools/call":
+        return _call_tool(msg_id, params, call_tool)
+
+    return _error(msg_id, METHOD_NOT_FOUND, f"Method not found: {method}")
+
+
+def _call_tool(msg_id, params, call_tool, extra=None):
+    name = params.get("name")
+    if name != tool_definition()["name"]:
+        return _error(msg_id, INVALID_PARAMS, f"Unknown tool: {name}")
+    arguments = params.get("arguments") or {}
+    try:
+        result, meta = call_tool(arguments)
+    except Exception as e:
+        # Tool failures are reported in the result so the model can see them.
+        return _result(
+            msg_id,
+            {
+                "content": [{"type": "text", "text": f"{type(e).__name__}: {e}"}],
+                "isError": True,
+                **(extra or {}),
+            },
+        )
+    content = {
+        "content": [{"type": "text", "text": json.dumps(result)}],
+        "isError": False,
+        "_meta": {"sebs": meta},
+        **(extra or {}),
+    }
+    if isinstance(result, dict):
+        content["structuredContent"] = result
+    return _result(msg_id, content)
+
+
+def _handle_modern(msg_id, method, params, version, call_tool, meta):
+    """A 2026-07-28 request: no session, the version comes with every request."""
+    if version not in MODERN_PROTOCOL_VERSIONS:
+        error = _error(msg_id, UNSUPPORTED_PROTOCOL_VERSION, f"Unsupported protocol version: {version}")
+        error["error"]["data"] = {"supported": MODERN_PROTOCOL_VERSIONS + PROTOCOL_VERSIONS, "requested": version}
+        return error
+    complete = {"resultType": "complete"}
+    sebs_meta = {"sebs": meta} if meta else {}
+
+    if method == "server/discover":
+        return _result(msg_id, {
+            "supportedVersions": MODERN_PROTOCOL_VERSIONS,
+            "capabilities": {"tools": {"listChanged": False}},
+            **complete, **CACHE,
+            "_meta": {SERVER_INFO_META: SERVER_INFO, **sebs_meta},
+        })
+
+    if method == "tools/list":
+        result = {"tools": [tool_definition()], **complete, **CACHE}
+        if sebs_meta:
+            result["_meta"] = sebs_meta
+        return _result(msg_id, result)
+
+    if method == "tools/call":
+        return _call_tool(msg_id, params, call_tool, complete)
+
+    # initialize and ping no longer exist; other features are not offered.
+    return _error(msg_id, METHOD_NOT_FOUND, f"Method not found: {method}")
