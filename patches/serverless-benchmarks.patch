@@ -0,0 +1,36 @@
+# Copyright 2020-2025 ETH Zurich and the SeBS authors. All rights reserved.
+"""The api-proxy tool as an MCP server built on the official Python SDK.
+
+Same tool logic as the default variant (function.py), registered the way real MCP
+servers do: an `MCPServer` instance at module level and a decorated, typed tool
+function, whose signature becomes the input schema. The SeBS wrapper finds `mcp`
+here and serves it through the SDK's Streamable HTTP app.
+"""
+
+from typing import Annotated, Any
+
+from mcp.server.mcpserver import MCPServer
+from pydantic import Field
+
+from . import function
+
+mcp = MCPServer("sebs-api-proxy")
+
+
+@mcp.tool()
+def search_products(
+    upstream: Annotated[str, Field(description="Benchmark parameter: base URL of the upstream API.")],
+    latency_ms: Annotated[float, Field(description="Benchmark parameter: upstream response delay in milliseconds.")] = 0,
+    size: Annotated[int, Field(description="Benchmark parameter: upstream response size in bytes.")] = 1024,
+    seed: Annotated[int, Field(description="Benchmark parameter: selects the generated catalog.")] = 0,
+    limit: Annotated[int, Field(description="Maximum number of products to return.")] = 10,
+    in_stock_only: Annotated[bool, Field(description="Only return products that are in stock.")] = True,
+    reuse_connection: Annotated[
+        bool, Field(description="Benchmark parameter: keep the upstream connection alive across calls.")
+    ] = True,
+) -> dict[str, Any]:
+    """Search the product catalog and return the best-rated matching products."""
+    return function.handler(dict(
+        upstream=upstream, latency_ms=latency_ms, size=size, seed=seed, limit=limit,
+        in_stock_only=in_stock_only, reuse_connection=reuse_connection,
+    ))
